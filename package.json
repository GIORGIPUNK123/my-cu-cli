{
  "name": "my-cu-cli",
  "version": "1.0.3",
  "description": "CLI for checking CU student information from terminal",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node ./dist/index.js info",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon --exec ts-node ./src/index.ts info",
    "build": "tsc",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "prepack": "npm run clean && npm run build",
    "release:check": "npm run clean && npm run build"
  },
  "author": "Giorgi Charashvili",
  "license": "MIT",
  "bin": {
    "my-cu": "dist/index.js"
  },
  "files": [
    "dist",
    "README"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2",
    "puppeteer": "^24.40.0"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.3.2",
    "@inquirer/select": "^5.1.2",
    "@types/inquirer": "^9.0.9",
    "@types/puppeteer": "^7.0.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
